# Keys for the model providers used by the pipeline.
#
# Which model each stage uses is NOT set here: it lives in book_splitter.toml
# (one [llm] table plus an optional [llm.<stage>] table per stage:
# split, preprocess, dictionary, matter, translate, postprocess). Override one
# field for one run with --llm, or point at another file with --llm-config:
#
#   python scripts/run_pipeline.py BOOK.md \
#       --llm split.model=deepseek-flash \
#       --llm translate.provider=lmstudio
#   BOOK_SPLITTER_CONFIG=/tmp/cheap.toml python scripts/run_pipeline.py BOOK.md
#
# Never commit a real key.
# DeepSeek's current ids: deepseek-flash (V4.1 Flash, the default) and
# deepseek-v4-pro (stronger, thinking). deepseek-chat / deepseek-reasoner are
# retired legacy aliases.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# A local LM Studio / Ollama endpoint normally needs no key.
LM_STUDIO_API_KEY=
OLLAMA_API_KEY=

# Optional: a variable an [llm.<stage>] section reads instead of the provider's
# own key variable, e.g.  api_key_env = "MY_TRANSLATION_KEY"  in book_splitter.toml.
# MY_TRANSLATION_KEY=

# ---------------------------------------------------------------------------
# Per-stage environment overrides (optional). They beat book_splitter.toml but
# lose to --llm and to a stage's own command-line flags. The provider-specific
# key variables above are still where the secrets belong.
# ---------------------------------------------------------------------------
# SPLITTER_SPLIT_PROVIDER=deepseek
# SPLITTER_SPLIT_MODEL=deepseek-flash
# SPLITTER_SPLIT_BASE_URL=https://api.deepseek.com/v1
# SPLITTER_PREPROCESS_MODEL=deepseek-flash
# SPLITTER_DICTIONARY_MODEL=deepseek-flash
# SPLITTER_MATTER_MODEL=deepseek-flash
# SPLITTER_POSTPROCESS_MODEL=deepseek-flash
# SPLITTER_TRANSLATE_MODEL=deepseek-flash

# Stage 7 shorthand: TRANSLATION_* is the same as SPLITTER_TRANSLATE_*.
#   deepseek  the cloud choice (https://api.deepseek.com/v1, deepseek-flash)
#   lmstudio  the model you host at http://127.0.0.1:1234/v1 (no key needed)
# TRANSLATION_PROVIDER=lmstudio
# TRANSLATION_BASE_URL=http://127.0.0.1:1234/v1
# TRANSLATION_MODEL=gemma-4-31b-en2sr-v3@q4_k_m
# TRANSLATION_API_KEY=

# ---------------------------------------------------------------------------
# Legacy shared fallbacks (optional, lowest priority). A config file wins over
# these, so they are only useful for a machine with no book_splitter.toml.
# ---------------------------------------------------------------------------
# SPLITTER_PROVIDER=deepseek
# SPLITTER_MODEL=deepseek-flash
# SPLITTER_BASE_URL=https://api.deepseek.com/v1
# SPLITTER_API_KEY=
# SPLITTER_TEMPERATURE=0.0

# Another per-stage config file (the same as --llm-config).
# BOOK_SPLITTER_CONFIG=/path/to/book_splitter.toml
