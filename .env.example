# Provider for the routing LLM (openai-compatible endpoints all work).
# Options: deepseek | openai | openrouter | lmstudio | ollama
SPLITTER_PROVIDER=deepseek
SPLITTER_MODEL=deepseek-flash
SPLITTER_BASE_URL=https://api.deepseek.com/v1

# Credentials are read from this variable (or from the provider's own variable,
# e.g. OPENAI_API_KEY / DEEPSEEK_API_KEY). Never commit a real key.
SPLITTER_API_KEY=

# A fully local setup, for reference:
# SPLITTER_PROVIDER=lmstudio
# SPLITTER_MODEL=qwen/qwen3.8-27b
# SPLITTER_BASE_URL=http://127.0.0.1:1234/v1
# SPLITTER_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Stage 7 (translation) only — two choices, independent of the stages above.
#   deepseek  the cloud default (https://api.deepseek.com/v1, deepseek-flash)
#   lmstudio  the model you host at http://127.0.0.1:1234/v1
# Front/back matter (stage 6b) and every other stage keep SPLITTER_* above.
# ---------------------------------------------------------------------------
TRANSLATION_PROVIDER=deepseek

# The local choice. The model can be omitted: the loaded id is discovered from
# LM Studio's GET /v1/models (a translation-tuned "en2sr" model wins if several
# are loaded). Set it explicitly to pin one:
# TRANSLATION_PROVIDER=lmstudio
# TRANSLATION_BASE_URL=http://127.0.0.1:1234/v1
# TRANSLATION_MODEL=gemma-4-31b-en2sr-v3@q4_k_m

# Optional: a key for stage 7 only. A localhost endpoint needs none.
# TRANSLATION_API_KEY=
